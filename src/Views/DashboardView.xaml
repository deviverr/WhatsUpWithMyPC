<UserControl x:Class="WhatsUpWithMyPC.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WhatsUpWithMyPC.ViewModels"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.DataContext>
        <vm:DashboardViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="System Dashboard"
                       Style="{StaticResource HeadingStyle}"
                       Margin="0,0,0,24"/>

            <!-- Stats Grid -->
            <UniformGrid Columns="3" Rows="2" Margin="0,0,0,24">
                <!-- CPU Card -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE950;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="24"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="CPU" Style="{StaticResource SubheadingStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock FontSize="36" FontWeight="Light"
                                   Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="{Binding CpuUsage, StringFormat={}{0:F0}, Mode=OneWay}"/><Run Text="%" FontSize="20"/>
                        </TextBlock>
                        <ProgressBar Value="{Binding CpuUsage}"
                                     Maximum="100"
                                     Style="{StaticResource ModernProgressBarStyle}"
                                     Margin="0,12,0,8"/>
                        <TextBlock Text="{Binding CpuName}"
                                   Style="{StaticResource CaptionStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- RAM Card -->
                <Border Style="{StaticResource CardStyle}" Margin="6,0,6,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE964;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="24"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="Memory" Style="{StaticResource SubheadingStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock FontSize="36" FontWeight="Light"
                                   Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="{Binding RamUsed, StringFormat={}{0:F1}, Mode=OneWay}"/><Run Text=" GB" FontSize="20"/>
                        </TextBlock>
                        <ProgressBar Value="{Binding RamUsagePercent}"
                                     Maximum="100"
                                     Style="{StaticResource ModernProgressBarStyle}"
                                     Margin="0,12,0,8"/>
                        <TextBlock Style="{StaticResource CaptionStyle}">
                            <Run Text="{Binding RamUsed, StringFormat={}{0:F1}, Mode=OneWay}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding RamTotal, StringFormat={}{0:F1}, Mode=OneWay}"/>
                            <Run Text="GB used"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- GPU Card -->
                <Border Style="{StaticResource CardStyle}" Margin="12,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE7F4;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="24"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="GPU" Style="{StaticResource SubheadingStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding GpuName}"
                                   FontSize="18" FontWeight="Light"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="50"/>
                        <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,12,0,0">
                            <Run Text="VRAM: "/>
                            <Run Text="{Binding GpuMemory, StringFormat={}{0:F1} GB, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Disk Card -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xEDA2;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="24"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="Disk" Style="{StaticResource SubheadingStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Disks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="{Binding DriveLetter, Mode=OneWay}"
                                                       Style="{StaticResource BodyStyle}"/>
                                            <TextBlock HorizontalAlignment="Right"
                                                       Style="{StaticResource CaptionStyle}">
                                                <Run Text="{Binding FreeGB, StringFormat={}{0:F0}, Mode=OneWay}"/>
                                                <Run Text="GB free"/>
                                            </TextBlock>
                                        </Grid>
                                        <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}"
                                                     Maximum="100"
                                                     Style="{StaticResource ModernProgressBarStyle}"
                                                     Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Network Card -->
                <Border Style="{StaticResource CardStyle}" Margin="6,0,6,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE839;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="24"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="Network" Style="{StaticResource SubheadingStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Download" Style="{StaticResource CaptionStyle}"/>
                                <TextBlock Text="{Binding DownloadSpeed}"
                                           Style="{StaticResource BodyStyle}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Upload" Style="{StaticResource CaptionStyle}"/>
                                <TextBlock Text="{Binding UploadSpeed}"
                                           Style="{StaticResource BodyStyle}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding NetworkStatus}"
                                   Style="{StaticResource CaptionStyle}"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Battery/Uptime Card -->
                <Border Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE83F;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="24"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="System" Style="{StaticResource SubheadingStyle}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Battery (if available) -->
                        <StackPanel Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource CaptionStyle}">Battery</TextBlock>
                            <Grid Margin="0,4,0,8">
                                <ProgressBar Value="{Binding BatteryPercent}"
                                             Maximum="100"
                                             Style="{StaticResource ModernProgressBarStyle}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionStyle}">
                                <Run Text="{Binding BatteryPercent, StringFormat={}{0:F0}%, Mode=OneWay}"/>
                                <Run Text=" - "/>
                                <Run Text="{Binding BatteryStatus, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Uptime -->
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Uptime" Style="{StaticResource CaptionStyle}"/>
                            <TextBlock Text="{Binding Uptime}"
                                       Style="{StaticResource BodyStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Quick Actions -->
            <TextBlock Text="Quick Actions"
                       Style="{StaticResource SubheadingStyle}"
                       Margin="0,0,0,12"/>

            <WrapPanel>
                <Button Content="Run Health Check"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding RunHealthCheckCommand}"
                        Margin="0,0,12,0"/>
                <Button Content="Quick Cleanup"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RunCleanupCommand}"
                        Margin="0,0,12,0"/>
                <Button Content="Refresh Stats"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshCommand}"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
