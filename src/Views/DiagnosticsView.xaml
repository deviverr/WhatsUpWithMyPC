<UserControl x:Class="WhatsUpWithMyPC.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WhatsUpWithMyPC.ViewModels"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.DataContext>
        <vm:DiagnosticsViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <!-- Header -->
            <TextBlock Text="Hardware Diagnostics"
                       Style="{StaticResource HeadingStyle}"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Test and diagnose hardware health"
                       Style="{StaticResource CaptionStyle}"
                       Margin="0,0,0,24"/>

            <!-- Disk Health -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource IconFont}"
                                       FontSize="20" Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Disk Health" Style="{StaticResource SubheadingStyle}"/>
                        </StackPanel>
                        <Button Content="Check SMART"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding CheckDiskHealthCommand}"
                                HorizontalAlignment="Right"
                                Padding="16,8"/>
                    </Grid>

                    <!-- Disk Health Results -->
                    <ItemsControl ItemsSource="{Binding DiskHealthResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceLightBrush}"
                                        CornerRadius="4"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DriveName, Mode=OneWay}"
                                                       Style="{StaticResource BodyStyle}"
                                                       FontWeight="Medium"/>
                                            <TextBlock Text="{Binding Model, Mode=OneWay}"
                                                       Style="{StaticResource CaptionStyle}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Background="{Binding StatusColor, Mode=OneWay}"
                                                CornerRadius="4"
                                                Padding="12,4">
                                            <TextBlock Text="{Binding Status, Mode=OneWay}"
                                                       Foreground="White"
                                                       FontWeight="Medium"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Run SMART check to see disk health status"
                               Style="{StaticResource CaptionStyle}"
                               Visibility="{Binding HasNoDiskResults, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <!-- Memory Test -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE950;" FontFamily="{StaticResource IconFont}"
                                       FontSize="20" Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Memory Test" Style="{StaticResource SubheadingStyle}"/>
                        </StackPanel>
                        <Button Content="{Binding MemoryTestButtonText, Mode=OneWay}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding RunMemoryTestCommand}"
                                HorizontalAlignment="Right"
                                Padding="16,8"/>
                    </Grid>

                    <ProgressBar Value="{Binding MemoryTestProgress, Mode=OneWay}"
                                 Maximum="100"
                                 Style="{StaticResource ModernProgressBarStyle}"
                                 Visibility="{Binding IsMemoryTestRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding MemoryTestStatus, Mode=OneWay}"
                               Style="{StaticResource BodyStyle}"/>
                </StackPanel>
            </Border>

            <!-- CPU Stress Test -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}"
                                       FontSize="20" Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="CPU Stress Test" Style="{StaticResource SubheadingStyle}"/>
                        </StackPanel>
                        <Button Content="{Binding CpuTestButtonText, Mode=OneWay}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding RunCpuTestCommand}"
                                HorizontalAlignment="Right"
                                Padding="16,8"/>
                    </Grid>

                    <ProgressBar Value="{Binding CpuTestProgress, Mode=OneWay}"
                                 Maximum="100"
                                 Style="{StaticResource ModernProgressBarStyle}"
                                 Visibility="{Binding IsCpuTestRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding CpuTestStatus, Mode=OneWay}"
                               Style="{StaticResource BodyStyle}"/>

                    <TextBlock Text="Warning: CPU stress test will temporarily increase CPU usage to 100%"
                               Style="{StaticResource CaptionStyle}"
                               Foreground="{StaticResource WarningBrush}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- System Information -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}"
                                   FontSize="20" Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="System Information" Style="{StaticResource SubheadingStyle}"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="OS:" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WindowsVersion, Mode=OneWay}" Style="{StaticResource BodyStyle}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="CPU:" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CpuName, Mode=OneWay}" Style="{StaticResource BodyStyle}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="RAM:" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalRam, Mode=OneWay}" Style="{StaticResource BodyStyle}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="GPU:" Style="{StaticResource CaptionStyle}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GpuName, Mode=OneWay}" Style="{StaticResource BodyStyle}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Display:" Style="{StaticResource CaptionStyle}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DisplayInfo, Mode=OneWay}" Style="{StaticResource BodyStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
