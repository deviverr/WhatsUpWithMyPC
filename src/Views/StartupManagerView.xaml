<UserControl x:Class="WhatsUpWithMyPC.Views.StartupManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WhatsUpWithMyPC.ViewModels"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.DataContext>
        <vm:StartupManagerViewModel/>
    </UserControl.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Startup Manager"
                       Style="{StaticResource HeadingStyle}"/>
            <TextBlock Text="Control which programs run when Windows starts"
                       Style="{StaticResource CaptionStyle}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Summary -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource BodyStyle}">
                        <Run Text="{Binding EnabledCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        <Run Text=" enabled"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyStyle}" Margin="24,0,0,0">
                        <Run Text="{Binding DisabledCount, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text=" disabled"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyStyle}" Margin="24,0,0,0">
                        <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text=" total"/>
                    </TextBlock>
                </StackPanel>
                <Button Content="Refresh"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Right"
                        Padding="16,6"/>
            </Grid>
        </Border>

        <!-- Startup Items List -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <ListBox ItemsSource="{Binding StartupItems}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Enable/Disable Toggle -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsEnabled}"
                                          Style="{StaticResource ModernCheckBoxStyle}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,16,0"/>

                                <!-- Item Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name, Mode=OneWay}"
                                               Style="{StaticResource BodyStyle}"
                                               FontWeight="Medium"/>
                                    <TextBlock Text="{Binding Path, Mode=OneWay}"
                                               Style="{StaticResource CaptionStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="400"/>
                                </StackPanel>

                                <!-- Impact -->
                                <Border Grid.Column="2"
                                        Background="{StaticResource SurfaceLightBrush}"
                                        CornerRadius="4"
                                        Padding="8,4"
                                        VerticalAlignment="Center"
                                        Margin="16,0">
                                    <TextBlock Text="{Binding Impact, Mode=OneWay}"
                                               Style="{StaticResource CaptionStyle}"
                                               FontSize="11"/>
                                </Border>

                                <!-- Location -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Location, Mode=OneWay}"
                                           Style="{StaticResource CaptionStyle}"
                                           VerticalAlignment="Center"
                                           Width="120"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="4">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background"
                                                        Value="{StaticResource SurfaceLightBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background"
                                                        Value="{StaticResource SurfaceLightBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Empty State -->
                <TextBlock Text="No startup items found"
                           Style="{StaticResource CaptionStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage, Mode=OneWay}"
                   Style="{StaticResource CaptionStyle}"
                   Margin="0,12,0,0"/>
    </Grid>
</UserControl>
